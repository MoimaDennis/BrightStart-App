<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/bs_bg">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚙️ Settings" android:fontFamily="serif" android:textStyle="bold"
        android:textSize="26sp" android:textColor="@color/bs_text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose how Bright Start looks for you. Changes are saved to your account."
        android:textSize="14sp" android:textColor="@color/bs_muted" android:layout_marginBottom="20dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@drawable/bs_card">
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swDark" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Dark theme" android:textColor="@color/bs_text"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swLarge" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Large text" android:textColor="@color/bs_text"
            android:layout_marginTop="16dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swSlider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Show dashboard banner slider" android:textColor="@color/bs_text"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="💾 Save settings" android:layout_marginTop="24dp"
        android:backgroundTint="@color/bs_accent" android:textColor="@color/bs_on_accent" app:cornerRadius="50dp"/>
    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Log out"
        android:backgroundTint="@color/bs_accent" android:textColor="@color/bs_on_accent" app:cornerRadius="50dp"/>
</LinearLayout>