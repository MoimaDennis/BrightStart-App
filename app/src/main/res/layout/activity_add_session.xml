<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bs_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Bs.Heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🗓️ Schedule Session" android:textSize="28sp" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp" android:background="@drawable/bs_card">
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Program" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spProgram" style="@style/Bs.Spinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Volunteer" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spVolunteer" style="@style/Bs.Spinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Session date" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etDate" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="YYYY-MM-DD" android:inputType="date"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start time" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etStart" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="HH:MM (e.g. 14:00)" android:inputType="time"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="End time" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etEnd" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="HH:MM (e.g. 15:30)" android:inputType="time"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Venue" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etVenue" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
            <TextView android:id="@+id/tvNote" style="@style/Bs.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/bs_warning" android:layout_marginTop="12dp" android:visibility="gone"/>
            <Button android:id="@+id/btnSaveSession" style="@style/Bs.Button" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Save session" android:layout_marginTop="22dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
