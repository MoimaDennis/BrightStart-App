<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bs_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Bs.Heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📈 Record Performance" android:textSize="28sp" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp" android:background="@drawable/bs_card">
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Program" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spProgram" style="@style/Bs.Spinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spStudent" style="@style/Bs.Spinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assessment date" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etDate" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="YYYY-MM-DD" android:inputType="date"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Score (0-100)" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etScore" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/>
            <TextView android:id="@+id/tvGrade" style="@style/Bs.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/bs_accent" android:textStyle="bold" android:layout_marginTop="8dp" android:text="Auto grade: -"/>
            <TextView style="@style/Bs.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Comments (optional)" android:layout_marginTop="14dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etComments" style="@style/Bs.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2"/>
            <TextView android:id="@+id/tvNote" style="@style/Bs.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/bs_warning" android:layout_marginTop="10dp" android:visibility="gone"/>
            <Button android:id="@+id/btnSavePerf" style="@style/Bs.Button" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Save performance" android:layout_marginTop="22dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
