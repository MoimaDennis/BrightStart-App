<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Bs.Heading" parent="">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textColor">@color/bs_text</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="Bs.Label" parent="">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/bs_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="Bs.Body" parent="">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/bs_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Bs.Input" parent="">
        <item name="android:background">@drawable/bs_input</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/bs_text</item>
        <item name="android:textColorHint">@color/bs_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Bs.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bs_accent</item>
        <item name="android:textColor">@color/bs_on_accent</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">50dp</item>
    </style>
    <style name="Bs.ButtonGoogle" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#333333</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">#DDDDDD</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">50dp</item>
    </style>
    <style name="Bs.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bs_spinner</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
    </style>
</resources>
